## Performance Optimization
```csharp
// Use appropriate collection types
public class ElementCache
{
    private readonly ConcurrentDictionary<ElementId, ElementInfo> _cache = new();
    private readonly Dictionary<string, List<ElementId>> _categoryIndex = new();
    
    // Use spans for performance-critical operations
    public void ProcessElementIds(ReadOnlySpan<ElementId> elementIds)
    {
        foreach (var id in elementIds)
        {
            // Process each ID
        }
    }
    
    // Use collection expressions (C# 12+)
    // .NET Framework alternative: return elementIds.Select(id => _cache[id]).ToList();
    public List<ElementInfo> GetElementsByCategory(string category)
    {
        if (!_categoryIndex.TryGetValue(category, out var elementIds))
            return [];
            
        return [.. elementIds.Select(id => _cache[id])];
    }
}

// Implement IDisposable for resource cleanup
public class ElementProcessor : IElementProcessor, IDisposable
{
    private readonly Timer _cleanupTimer;
    private bool _disposed;
    
    public ElementProcessor()
    {
        _cleanupTimer = new Timer(Cleanup, null, TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
    }
    
    public void Dispose()
    {
        if (_disposed) return;
        
        _cleanupTimer?.Dispose();
        _disposed = true;
    }
}
```

